{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__DSH_HOOKS_DIR__/dsh-hook.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__DSH_HOOKS_DIR__/dsh-hook.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__DSH_HOOKS_DIR__/dsh-hook.sh\"",
            "timeout": 300
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__DSH_HOOKS_DIR__/dsh-hook.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__DSH_HOOKS_DIR__/dsh-hook.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
